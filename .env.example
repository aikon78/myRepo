# Copia questo file in .env e aggiungi le tue API keys

# Mistral API Key (richiesta)
# Ottienila da: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your-mistral-api-key-here

# Anthropic API Key (opzionale, se vuoi usare Claude)
# Ottienila da: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Altre configurazioni
MODEL=mistral-small-latest
TEMPERATURE=0.7
MAX_TOKENS=1000
