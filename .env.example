# Copia questo file in .env e aggiungi le tue API keys

# OpenAI API Key (richiesta)
# Ottienila da: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (opzionale, se vuoi usare Claude)
# Ottienila da: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Altre configurazioni
MODEL=gpt-3.5-turbo
TEMPERATURE=0.7
MAX_TOKENS=1000
